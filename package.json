{
  "name": "@corsair/icuewidget-cli",
  "version": "0.4.0",
  "description": "Create, validate, update, and package CORSAIR iCUE widgets.",
  "type": "module",
  "bin": {
    "icuewidget": "./node-bin/icuewidget.js"
  },
  "files": [
    "node-bin/",
    "src-node/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test-node/*.test.js",
    "build:binaries": "node scripts/build-binaries.mjs",
    "build:installers": "node scripts/build-installers.mjs",
    "build": "npm run build:binaries && npm run build:installers",
    "check": "node --check scripts/build-binaries.mjs && node --check scripts/build-installers.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "corsair",
    "icue",
    "widget",
    "cli"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.5.1"
  }
}
